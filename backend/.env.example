# ===== 数据库 =====
# 本地开发用 SQLite（一个文件，零安装）
DATABASE_URL=sqlite:///./ticket_hub.db

# ===== JWT 认证 =====
# 签名密钥，生产环境必须换成随机长字符串
# 生成方式：命令行执行  openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-secret

# 签名算法（HS256 是业界默认）
JWT_ALGORITHM=HS256

# token 有效期（分钟），1440 = 24 小时
ACCESS_TOKEN_EXPIRE_MINUTES = 1440

AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash